{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carllaliberte/figure-protocol/schema/figure.v0.json",
  "title": "FIGURE v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "figure_id", "nom_public", "majeur", "usages", "juridiction", "langue", "fin", "revocable"],
  "properties": {
    "format": { "const": "figure.v0" },
    "figure_id": { "type": "string" },
    "nom_public": { "type": "string" },
    "majeur": { "const": true },
    "juridiction": { "type": "string", "examples": ["QC"] },
    "langue": { "type": "string", "examples": ["fr-CA"] },
    "usages": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["nom", "voix", "visage", "mandat"] }
    },
    "interdits": { "type": "array", "items": { "type": "string" } },
    "identite_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "temoin_id": { "type": ["string", "null"] },
    "transcript_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "debut": { "type": ["string", "null"] },
    "fin": { "type": "string" },
    "revocable": { "const": true },
    "note": { "type": "string" }
  }
}
